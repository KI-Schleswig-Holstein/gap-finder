# Run real LLM integration tests. They are skipped unless this is set to 1.
GAP_FINDER_RUN_LLM_INTEGRATION=0

# Which chat backend to exercise: all, api, or local.
GAP_FINDER_LLM_INTEGRATION_BACKEND=all

# Chat model names are backend-specific because local repository IDs and API
# model identifiers are not interchangeable.
GAP_FINDER_LLM_INTEGRATION_LOCAL_MODEL_NAME=Qwen/Qwen3-0.6B
GAP_FINDER_LLM_INTEGRATION_API_MODEL_NAME=gpt-oss-20b

# Hugging Face/local chat model device.
GAP_FINDER_LLM_INTEGRATION_DEVICE=cuda

# OpenAI-compatible API settings.
GAP_FINDER_LLM_INTEGRATION_API_BASE_URL=http://localhost:11434/v1
GAP_FINDER_API_KEY=-

# Run real embedding integration tests. They are independently opt-in.
GAP_FINDER_RUN_EMBEDDING_INTEGRATION=0

# Which embedding backend to exercise: all, api, or local.
GAP_FINDER_EMBEDDING_INTEGRATION_BACKEND=all
GAP_FINDER_EMBEDDING_INTEGRATION_LOCAL_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
GAP_FINDER_EMBEDDING_INTEGRATION_API_MODEL_NAME=nomic-embed-text
GAP_FINDER_EMBEDDING_INTEGRATION_API_BASE_URL=http://localhost:11434/v1

# PDF/vector-store integration embedding model.
GAP_FINDER_PDF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Topic generation integration settings.
GAP_FINDER_TOPIC_GENERATION_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
GAP_FINDER_TOPIC_GENERATION_LANGUAGE=german
